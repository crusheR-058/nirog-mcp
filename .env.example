# Server
PORT=3333
HOST=127.0.0.1

# Consent tokens. Required in any deployment. Mint one with: pnpm consent-token pat_rahul --sub yadav-household --days 30
# NIROG_TOKEN_SECRET=change-me-to-a-long-random-string

# AWS / Bedrock (ap-south-1 Mumbai has GPT-OSS 120B, Claude via global profiles, Titan Embed v2)
AWS_REGION=ap-south-1
BEDROCK_CHAT_MODEL=openai.gpt-oss-120b-1:0
# Fallback if intake question quality or structured output disappoints: global.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0   # 1024 dims

# Data source: mock (built-in demo patients) | supabase (live Nirog project)
NIROG_DATA_SOURCE=mock
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Clinical memory: memory (in-process, seeded with the demo history) | pg (Postgres)
MEMORY_STORE=memory
# MEMORY_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres   # Supabase Session-mode URI
# MEMORY_PG_FLAVOUR=pgvector             # pgvector | cockroach

# Embeddings: offline (default, deterministic lexical) | bedrock (Titan via AWS_REGION)
EMBEDDER=offline

# ARIA's next-question model: uses BEDROCK_CHAT_MODEL via Bedrock, or set ARIA_MODEL=off for the deterministic fallback
# ARIA_MODEL=off

# Doctor portal sign-in. Create an OAuth client (Web) in Google Cloud Console and add your origin
# (e.g. http://127.0.0.1:3333 and your App Runner URL) to Authorized JavaScript origins.
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# One-time doctor verification: registration number must be on the allowlist, plus this invite code.
# CLINIC_INVITE_CODE=NIROG-2026
# DOCTOR_ALLOWLIST=[{"registrationNo":"HPR-KA-2019-44817","name":"Dr. Ananya Rao","specialty":"General Physician","clinic":"Nirog Rural Care Network"}]

# The clock doses are counted on, as minutes ahead of UTC. 330 is India Standard Time.
# CLINIC_UTC_OFFSET_MINUTES=330
