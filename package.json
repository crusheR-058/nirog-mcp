{
  "name": "nirog-mcp",
  "version": "1.0.0",
  "description": "MCP server and Agent Skill bringing Nirog telehealth intake to Alexa+",
  "main": "dist/http.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/http.ts",
    "start": "node --env-file-if-exists=.env dist/http.js",
    "build": "tsc -p tsconfig.json && vite build demo",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "verify": "tsx --env-file-if-exists=.env scripts/verify.ts",
    "consent-token": "tsx --env-file-if-exists=.env scripts/token.ts",
    "dev:demo": "vite demo",
    "build:demo": "vite build demo",
    "typecheck:demo": "tsc -p demo/tsconfig.json"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.10.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1146.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@supabase/supabase-js": "^2.117.2",
    "express": "^5.2.1",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.1.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "postprocessing": "^6.39.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "zustand": "^5.0.15"
  }
}
