{
  "name": "nirog-mcp",
  "version": "1.0.0",
  "description": "MCP server and Agent Skill bringing Nirog telehealth intake to Alexa+",
  "main": "dist/http.js",
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env watch src/http.ts",
    "start": "node --env-file-if-exists=.env dist/http.js",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "verify": "tsx --env-file-if-exists=.env scripts/verify.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.10.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1146.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@supabase/supabase-js": "^2.117.2",
    "express": "^5.2.1",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
